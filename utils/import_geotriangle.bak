"""
FOTools - Geodreieck Importer Addon
Imports geodreieck from a .blend file via an N-panel button
"""

import bpy
import os
from pathlib import Path

bl_info = {
    "name": "FOTools Geodreieck Importer",
    "author": "Your Name",
    "version": (1, 0, 0),
    "blender": (4, 0, 0),
    "location": "View3D > Sidebar > FOTools",
    "description": "Import geodreieck from .blend file",
    "category": "3D View",
}

# ============================================================================
# Helper Functions
# ============================================================================

def get_addon_directory():
    """Get the directory where this addon is installed"""
    return Path(__file__).parent

def get_geodreieck_blend_path():
    """Get the path to the geodreieck.blend file"""
    addon_dir = get_addon_directory()
    blend_path = addon_dir / "img" / "geodreieck.blend"
    return str(blend_path)

# ============================================================================
# Operator: Import Geodreieck
# ============================================================================

class FOT_OT_ImportGeodreieck(bpy.types.Operator):
    """Import Geodreieck from .blend file"""
    bl_idname = "object.import_geodreieck"
    bl_label = "Import Geodreieck"
    bl_options = {'REGISTER', 'UNDO'}
    
    def execute(self, context):
        blend_path = get_geodreieck_blend_path()
        
        # Check if file exists
        if not os.path.exists(blend_path):
            self.report({'ERROR'}, f"Geodreieck file not found: {blend_path}")
            return {'CANCELLED'}
        
        # Get cursor location
        cursor_location = context.scene.cursor.location.copy()
        
        # Import all objects from the blend file
        with bpy.data.libraries.load(blend_path, link=False) as (data_from, data_to):
            data_to.objects = [name for name in data_from.objects if name == "Geodreieck"]
        
        # Link imported objects to current collection
        imported_objects = []
        for obj in data_to.objects:
            if obj is not None:
                context.collection.objects.link(obj)
                obj.location = cursor_location
                imported_objects.append(obj)
        
        if not imported_objects:
            self.report({'WARNING'}, "No 'Geodreieck' object found in the .blend file")
            return {'CANCELLED'}
        
        # Select imported objects
        bpy.ops.object.select_all(action='DESELECT')
        for obj in imported_objects:
            obj.select_set(True)
        context.view_layer.objects.active = imported_objects[0]
        
        self.report({'INFO'}, f"Imported {len(imported_objects)} geodreieck object(s)")
        return {'FINISHED'}

# ============================================================================
# Panel: Geodreieck Importer
# ============================================================================

class FOT_PT_GeodreieckImporter(bpy.types.Panel):
    """Panel for importing geodreieck"""
    bl_label = "Geodreieck Importer"
    bl_idname = "FOT_PT_geodreieck_importer"
    bl_space_type = 'VIEW_3D'
    bl_region_type = 'UI'
    bl_category = 'FOTools'
    
    def draw(self, context):
        layout = self.layout
        
        # Import button
        box = layout.box()
        box.label(text="Import Geodreieck:", icon='IMPORT')
        box.operator(
            FOT_OT_ImportGeodreieck.bl_idname,
            text="Add Geodreieck",
            icon='MESH_DATA'
        )
        
        # Info section
        box = layout.box()
        box.label(text="Info:", icon='INFO')
        blend_path = get_geodreieck_blend_path()
        
        if os.path.exists(blend_path):
            box.label(text="✓ geodreieck.blend found", icon='CHECKMARK')
        else:
            box.label(text="✗ geodreieck.blend not found", icon='ERROR')
            box.label(text="Expected location:")
            
            # Display path in smaller text
            col = box.column(align=True)
            col.scale_y = 0.8
            col.label(text=blend_path)

# ============================================================================
# Registration
# ============================================================================

classes = (
    FOT_OT_ImportGeodreieck,
    FOT_PT_GeodreieckImporter,
)

def register():
    """Register addon classes"""
    for cls in classes:
        bpy.utils.register_class(cls)
    
    print("Geodreieck Importer registered")

def unregister():
    """Unregister addon classes"""
    for cls in reversed(classes):
        bpy.utils.unregister_class(cls)
    
    print("Geodreieck Importer unregistered")

if __name__ == "__main__":
    register()